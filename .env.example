# Copy to .env in this directory (gitignored). Used by npm run dev:addon and related scripts.

# Patreon experimental addon license — required for dev:addon (never commit the real key)
HSM_DEV_LICENSE_KEY=

# Path to experimental addon repo if not ../hytale-server-manager-experimental
# HSM_EXPERIMENTAL_ADDON_REPO=C:/path/to/hytale-server-manager-experimental

# Set by npm run dev:remote — enable Remote sidebar + /api/remote routes
# HSM_ENABLE_REMOTE=1

# Optional default Hytale servers folder for backend dev
# HYTALE_ROOT_DIR=C:/Users/You/Documents/Hytale Servers

# Skip addon frontend/wheel rebuild when sources unchanged (npm run dev:addon -- --fast)
# HSM_ADDON_FAST=1

# hytale-remote Maven build only — override HytaleServer.jar path
# HYTALE_SERVER_JAR=C:/path/to/HytaleServer.jar
