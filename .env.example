# Copy to .env in this directory (gitignored). Optional local overrides for development.

# Set by npm run dev:remote - enable Remote sidebar + /api/remote routes
# HSM_ENABLE_REMOTE=1

# Optional default Hytale servers folder for backend dev
# HYTALE_ROOT_DIR=C:/Users/You/Documents/Hytale Servers

# hytale-remote Maven build only - override HytaleServer.jar path
# HYTALE_SERVER_JAR=C:/path/to/HytaleServer.jar
